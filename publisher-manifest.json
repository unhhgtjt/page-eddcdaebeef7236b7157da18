lans-table th {font-family: var(--font-mono);font-size: 12px;font-weight: 500;color: var(--text-muted);text-transform: uppercase}\ntable.plans-table th.col-feature {width: 22%;color: var(--text-dark)}\ntable.plans-table th.col-plan {width: 26%;color: var(--text-main)}\ntable.plans-table th.col-plan.featured {color: var(--accent)}\ntable.plans-table tbody tr {border-bottom: 1px solid var(--line)}\ntable.plans-table tbody tr:last-child {border-bottom: none}\ntable.plans-table td.feature-label {font-family: var(--font-mono);font-size: 13px;color: var(--text-muted)}\ntable.plans-table td.plan-cell {color: var(--text-main)}\n.price-block {font-family: var(--font-mono)}\n.price-main {font-size: 20px;font-weight: 700;color: #ffffff}\n.price-sub {font-size: 12px;color: var(--text-muted);margin-top: 4px}\n.tag-flag {display: inline-block;font-size: 10px;padding: 2px 6px;background-color: var(--accent-soft);color: var(--accent);font-family: var(--font-mono);margin-left: 8px;vertical-align: middle}\n.spec-list {list-style: none;font-size: 13px;line-height: 1.8;color: var(--text-muted)}\n.spec-list li::before {content: \"— \";color: var(--text-dark)}\n.steps-grid {display: grid;grid-template-columns: repeat(4, 1fr);gap: 40px}\n.step-card {display: flex;flex-direction: column}\n.step-index {font-family: var(--font-mono);font-size: 12px;color: var(--accent);margin-bottom: 16px}\n.step-card h3 {font-size: 15px;font-weight: 500;color: #ffffff;margin-bottom: 10px}\n.step-card p {font-size: 13px;color: var(--text-muted);line-height: 1.6}\n.clients-grid {display: grid;grid-template-columns: repeat(3, 1fr);gap: 48px}\n.client-box {display: flex;flex-direction: column}\n.client-box h3 {font-size: 15px;font-weight: 500;color: #ffffff;margin-bottom: 8px;display: flex;align-items: center;justify-content: space-between}\n.client-box .badge {font-family: var(--font-mono);font-size: 11px;color: var(--text-dark)}\n.client-box p {font-size: 13px;color: var(--text-muted);line-height: 1.6;margin-bottom: 16px}\n.client-spec {font-family: var(--font-mono);font-size: 12px;color: var(--text-muted);border-top: 1px solid var(--line);padding-top: 12px;margin-top: auto}\n.client-link {color: var(--accent);font-family: var(--font-mono);font-size: 12px;margin-top: 8px;display: inline-block}\n.client-link:hover {text-decoration: underline}\n.faq-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 48px 64px}\n.faq-item {display: flex;flex-direction: column}\n.faq-item h3 {font-size: 15px;font-weight: 500;color: #ffffff;margin-bottom: 12px;line-height: 1.4}\n.faq-item p {font-size: 13px;color: var(--text-muted);line-height: 1.7}\nfooter {border-top: 1px solid var(--line);padding: 48px 32px;max-width: 1360px;margin: 0 auto;font-family: var(--font-mono);font-size: 12px;color: var(--text-dark);display: flex;justify-content: space-between;align-items: center}\nfooter a {color: var(--text-muted)}\nfooter a:hover {color: var(--accent)}\n@media (max-width: 960px) {\n  .hero-layout {grid-template-columns: 1fr;padding: 48px 20px}\n  .hero-content {padding-right: 0}\n  .hero-void {display: none}\n  .content-wrapper {padding: 0 20px 60px 20px}\n  .steps-grid {grid-template-columns: 1fr 1fr;gap: 32px}\n  .clients-grid {grid-template-columns: 1fr;gap: 32px}\n  .faq-grid {grid-template-columns: 1fr;gap: 32px}\n  table.plans-table th, table.plans-table td {padding: 14px 16px}\n}\n@media (max-width: 600px) {\n  .nav-strip {padding: 0 16px}\n  .nav-links {gap: 14px}\n  .steps-grid {grid-template-columns: 1fr}\n  h1.brand-title {font-size: 26px}\n}\n</style><header class=\"nav-strip\">\n  <div class=\"nav-brand\">翻云梯 / DOCS</div>\n  <nav>\n    <ul class=\"nav-links\">\n      <li><a href=\"#plans\">规格矩阵</a></li>\n      <li><a href=\"#workflow\">接入规程</a></li>\n      <li><a href=\"#clients\">终端支持</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </nav>\n</header>\n\n<main>\n  <div class=\"hero-layout\">\n    <div class=\"hero-content\">\n      <div class=\"hero-meta\">配置文档编号 8310 / 传输协议规范</div>\n      <h1 class=\"brand-title\">翻云梯 链路代理与网络调度配置规范</h1>\n      <p class=\"hero-desc\">翻云梯面向分布式网络环境提供统一的代理规则下发与流量分流方案。本文档记录基础版、旗舰版与团队版的技术指标、客户端订阅结构以及运维排查准则。</p>\n      \n      <div class=\"hero-params\">\n        <div class=\"hero-params-row\">\n          <span>当前协议栈版本</span>\n          <span>Core 4.2 / TLS 1.3</span>\n        </div>\n        <div class=\"hero-params-row\">\n          <span>订阅解析模式</span>\n          <span>Base64 / Standard JSON</span>\n        </div>\n        <div class=\"hero-params-row\">\n          <span>节点路由策略</span>\n          <span>规则驱动 / 域名黑白名单</span>\n        </div>\n      </div>\n\n      <div class=\"hero-actions\">\n        <a href=\"#plans\" class=\"btn-primary\">调取方案参数</a>\n        <a href=\"#workflow\" class=\"btn-secondary\">查看操作步骤</a>\n      </div>\n    </div>\n    \n    <div class=\"hero-void\">\n      <div class=\"void-tag\">[ BUFFER ZONE - RESERVED NEGATIVE SPACE ]</div>\n      <p>系统状态：所有接口保持被动监听。<br>\n      更新时钟：UTC+8 00:00:00<br>\n      无外部探针干扰。</p>\n    </div>\n  </div>\n\n  <div class=\"content-wrapper\">\n    \n    <section id=\"plans\">\n      <div class=\"section-header\">\n        <div class=\"section-tag\">Specifications Matrix</div>\n        <h2 class=\"section-title\">服务规格与资费对比</h2>\n        <p class=\"section-intro\">以下参数依据当前系统订阅数据库生成，包含月度周期结算基准、带宽配额上限及连接设备限制。</p>\n      </div>\n\n      <div class=\"table-container\">\n        <table class=\"plans-table\">\n          <thead>\n            <tr>\n              <th class=\"col-feature\">技术指标</th>\n              <th class=\"col-plan\">基础版</th>\n              <th class=\"col-plan featured\">旗舰版 <span class=\"tag-flag\">推荐</span></th>\n              <th class=\"col-plan\">团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td class=\"feature-label\">结算资费 (月付)</td>\n              <td class=\"plan-cell\">\n                <div class=\"price-block\">\n                  <div class=\"price-main\">¥15</div>\n                  <div class=\"price-sub\">每月计费</div>\n                </div>\n              </td>\n              <td class=\"plan-cell\">\n                <div class=\"price-block\">\n                  <div class=\"price-main\">¥35</div>\n                  <div class=\"price-sub\">每月计费</div>\n                </div>\n              </td>\n              <td class=\"plan-cell\">\n                <div class=\"price-block\">\n                  <div class=\"price-main\">¥85</div>\n                  <div class=\"price-sub\">每月计费</div>\n                </div>\n              </td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">长期订阅折算 (年付)</td>\n              <td class=\"plan-cell\">按年付仅需 ¥150/年</td>\n              <td class=\"plan-cell\">按年付仅需 ¥350/年</td>\n              <td class=\"plan-cell\">按年付仅需 ¥850/年</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">周期数据配额</td>\n              <td class=\"plan-cell\">每月 100GB 传输流量</td>\n              <td class=\"plan-cell\">每月 300GB 传输流量</td>\n              <td class=\"plan-cell\">每月 1000GB 传输流量</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">同时在线设备上限</td>\n              <td class=\"plan-cell\">最多 3 台设备</td>\n              <td class=\"plan-cell\">最多 5 台设备</td>\n              <td class=\"plan-cell\">最多 20 台设备</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">网络链路与节点范围</td>\n              <td class=\"plan-cell\">普通线路节点池</td>\n              <td class=\"plan-cell\">IPLC 专线链路优化池</td>\n              <td class=\"plan-cell\">VIP 专属高带宽节点池</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">流媒体协议解析</td>\n              <td class=\"plan-cell\">基础流媒体访问支持</td>\n              <td class=\"plan-cell\">全节点原生流媒体解锁支持</td>\n              <td class=\"plan-cell\">企业定向分流与定制路由</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">服务响应层级</td>\n              <td class=\"plan-cell\">标准工单排队队列</td>\n              <td class=\"plan-cell\">7x24 优先工单支持</td>\n              <td class=\"plan-cell\">专属客户经理技术对接</td>\n            </tr>\n            <tr>\n              <td class=\"feature-label\">订阅操作入口</td>\n              <td class=\"plan-cell\"><a href=\"#\" class=\"btn-secondary\">选择方案</a></td>\n              <td class=\"plan-cell\"><a href=\"#\" class=\"btn-primary\">选择方案</a></td>\n              <td class=\"plan-cell\"><a href=\"#\" class=\"btn-secondary\">选择方案</a></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n\n    <section id=\"workflow\">\n      <div class=\"section-header\">\n        <div class=\"section-tag\">Procedure &amp; Setup</div>\n        <h2 class=\"section-title\">客户端接入规程</h2>\n        <p class=\"section-intro\">翻云梯采用标准化通用协议接口分发网络节点配置，请遵循以下四步完成接入。</p>\n      </div>\n\n      <div class=\"steps-grid\">\n        <div class=\"step-card\">\n          <div class=\"step-index\">01 / SUBSCRIBE</div>\n          <h3>获取分发订阅链接</h3>\n          <p>完成方案选择后，系统控制台将生成专属订阅 URL。该 URL 包含经过编码的节点清单及证书公钥，请妥善保存并避免外泄。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">02 / COMPLIANCE</div>\n          <h3>配置环境核对</h3>\n          <p>确认本地设备的系统时钟同步处于毫秒级误差内。网络代理协议对时间戳握手有严格校验，时钟偏移可能导致握手中断。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">03 / PARSE</div>\n          <h3>载入节点至解析端</h3>\n          <p>在支持对应协议的第三方或通用客户端中添加 Remote Subscription，粘贴翻云梯订阅地址，触发拉取并完成节点解析。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-index\">04 / ROUTING</div>\n          <h3>应用流量分流规则</h3>\n          <p>选用规则路由模式（Rule-based Routing），确保本地局域网与国内直连请求免走隧道，实现网络传输的分流优化。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"section-header\">\n        <div class=\"section-tag\">Platforms &amp; Protocols</div>\n        <h2 class=\"section-title\">终端平台与兼容说明</h2>\n        <p class=\"section-intro\">翻云梯基于业界开源协议标准传输，不强制绑定专有运行环境，各主流系统均可通过兼容工具进行配置。</p>\n      </div>\n\n      <div class=\"clients-grid\">\n        <div class=\"client-box\">\n          <h3>\n            <span>Windows 环境</span>\n            <span class=\"badge\">WIN64</span>\n          </h3>\n          <p>支持通过通用规则客户端加载翻云梯订阅源。具备系统级代理托管与 TUN 虚拟网卡两种接管模式，适用于桌面全局或进程代理。</p>\n          <div class=\"client-spec\">兼容协议：Shadowsocks / Trojan / VMess</div>\n          <a href=\"#\" class=\"client-link\">查看 Windows 配置参数参考 →</a>\n        </div>\n        <div class=\"client-box\">\n          <h3>\n            <span>macOS 与 iOS 环境</span>\n            <span class=\"badge\">DARWIN</span>\n          </h3>\n          <p>支持基于 NetworkExtension 框架的通用解析工具。在 iOS 设备上通过扫码即可同步节点资产，macOS 下支持规则热重载。</p>\n          <div class=\"client-spec\">兼容协议：Shadowsocks / Trojan / Vless</div>\n          <a href=\"#\" class=\"client-link\">查看 Apple 平台接入说明 →</a>\n        </div>\n        <div class=\"client-box\">\n          <h3>\n            <span>Linux 与 Android 环境</span>\n            <span class=\"badge\">POSIX</span>\n          </h3>\n          <p>Android 平台支持分应用代理策略；Linux 环境支持无界面的守护进程（Daemon）模式运行，适合部署于路由器或网关节点。</p>\n          <div class=\"client-spec\">兼容协议：Clash 内核 / Xray 内核规范</div>\n          <a href=\"#\" class=\"client-link\">查看 POSIX 环境脚本模板 →</a>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"section-header\">\n        <div class=\"section-tag\">Frequently Asked Questions</div>\n        <h2 class=\"section-title\">常见问题排查与技术释疑</h2>\n        <p class=\"section-intro\">针对连接认证、配额计算与路由分发等典型运行状态的说明汇总。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div class=\"faq-item\">\n          <h3>翻云梯的配额重置周期如何计算？</h3>\n          <p>数据传输配额按账单周期进行自然更新。例如账单日起始于每月 15 日，则在下月 15 日 00:00 自动重置已用流量统计，未消耗的流量不结转至下一周期。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>多设备同时在线的判定机制是什么？</h3>\n          <p>系统服务端按当前正在保持 TCP 活跃长连接或处于有效会话窗口内的唯一公网 IP 与客户端标识符组合进行计数。超出套餐对应设备上限后，新发起的连接请求将被限流或等待排队。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>遇到节点不可达或连接超时时应如何检查？</h3>\n          <p>首先请检查客户端本地时钟是否与标准网络时间一致；其次，确认订阅链接是否已在客户端内执行“更新订阅”以同步最新的服务器地址与端口；最后，请排查本地防火墙是否拦截了出站代理端口。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>旗舰版专线与普通节点的技术区别为何？</h3>\n          <p>旗舰版与团队版所使用的 IPLC 专线依托局域点对点内部通道传输数据，不经过公网国际出口链路，因而在国际公网拥堵时段仍能保持抖动率与丢包率处于较低区间。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>是否可以根据业务需要定制专属路由规则？</h3>\n          <p>团队版用户可通过系统后台配置特定私有 IP 范围或特定企业域名的解析分流策略。基础版与旗舰版则使用系统统一发布的标准分流规则列表。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>订阅地址被污染或泄露后如何处理？</h3>\n          <p>用户可在翻云梯管理面板中选择重置订阅令牌（Token）。重置后旧订阅 URL 立即失效，节点认证密钥同步更换，需在客户端中重新导入新链接。</p>\n        </div>\n      </div>\n    </section>\n\n  </div>\n</main>\n\n<footer>\n  <div>© 翻云梯 系统网络管理组. 仅供技术配置与参数对照参考.</div>\n  <div>DOC_VER: 8310-RELEASE / NO SVG / NO EXTERNAL ASSETS</div>\n</footer>",
